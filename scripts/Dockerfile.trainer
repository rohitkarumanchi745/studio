# Studio's BitNet trainers as standalone container workers (a separate
# container / cloud service — NOT part of the lean API image). The default
# SQL/tool worker pulls reward-labeled rollouts; the optional complete-policy
# command pulls one user's five typed trajectory contracts. Both publish LoRA
# adapters back only through their respective promotion gates.
#
# CPU-ONLY, AND THAT IS THE SLOW ROAD. Training does NOT happen on BitNet's
# packed 1-bit repo — transformers refuses to fine-tune it at all — but on the
# bf16 MASTER weights (microsoft/bitnet-b1.58-2B-4T-bf16, 4.8 GB), which are an
# ordinary dense model whose linears re-quantize to ternary on every forward.
# A measured SFT micro-batch on an Apple M1 (MPS, max_length=128) took ~170 s;
# a CPU box is not faster. This image is for a machine with no GPU at all, or
# for a smoke test. On a machine WITH an NVIDIA card, run the trainer directly
# with a CUDA torch wheel — scripts/README-training.md §3 — and do not use this
# Dockerfile. Serving BitNet is the CPU half; training is the GPU half.
#
# Build with ``scripts/`` as the context. Both policy trainers are included;
# orchestration chooses the command, while the historical SQL/tool trainer
# remains the default for backward compatibility:
#   docker build -f scripts/Dockerfile.trainer -t studio/trainer scripts/
FROM python:3.12-slim

WORKDIR /trainer
COPY requirements-trainer.txt .
# CPU torch wheel — small enough for a plain CPU box, and useless on a GPU
# one: `torch.cuda.is_available()` is False with this wheel no matter what
# card is present. A CUDA build needs the cu### index instead.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements-trainer.txt
COPY train_online.py .
COPY train_trajectory_policy.py .

# Config comes from the environment (see train_online.py header):
#   STUDIO_API_URL, STUDIO_TRAINER_EMAIL/PASSWORD (or STUDIO_TRAINER_TOKEN),
#   STUDIO_TRAIN_MODE=sft|dpo, STUDIO_TRAIN_BASE_MODEL, STUDIO_SERVE_URL, …
# Default: the continuous SQL/tool loop (poll → train → publish → repeat).
# Complete trajectory policy:
#   docker run ... studio/trainer python train_trajectory_policy.py \
#       --scope user:<stable-user-id>
CMD ["python", "train_online.py"]
