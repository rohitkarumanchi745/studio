# ── Auth & boot ─────────────────────────────────────────────────────────
# Demo mode: seeds admin/analyst/viewer@studio.local and allows a missing
# STUDIO_SECRET (random per-process secret; a restart logs everyone out).
# Local demos only — NEVER set this in production.
STUDIO_DEMO_MODE=1
# Required in production: >= 32 random characters, not a placeholder
# (change-me, secret, password, studio, ...). Boot fails otherwise. Signs JWTs
# and derives the Fernet key for stored API keys / M365 tokens — rotating it
# invalidates sessions and makes stored keys/tokens undecryptable.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
STUDIO_SECRET=
# First real admin (optional). Missing -> created with STUDIO_ADMIN_PASSWORD
# (>= 12 chars), role admin, already verified. ALREADY EXISTS -> promoted to
# admin only when the operator can prove they control it: the account is
# SSO-provisioned (no local password) or STUDIO_ADMIN_PASSWORD verifies against
# its stored hash. Anything else refuses the boot with a RuntimeError naming
# the conflict — setting this to an address someone else already registered
# must never hand them admin. The password is never rewritten, so rotating this
# var is a one-time env change; it can be removed after the first boot.
STUDIO_ADMIN_EMAIL=
STUDIO_ADMIN_PASSWORD=
# Self-service signup. Truthy = 1/true/yes; unset or blank follows the mode:
# ON in demo mode, OFF in production (a production Studio's accounts come from
# an administrator or from SSO — removing the seed accounts is pointless if
# anyone can mint a fresh one). When off, POST /api/auth/register answers 403.
# When on, registration creates an UNVERIFIED account and returns NO token:
# the emailed 6-digit code must be accepted by POST /api/auth/verify-email
# before /api/auth/login (or any authenticated request) will work.
# STUDIO_OPEN_REGISTRATION=

# ── State store ─────────────────────────────────────────────────────────
# Postgres for app state (users, chats, dashboards, jobs); unset = SQLite.
# DATABASE_URL=postgresql://user:pass@host:5432/studio
# Postgres state store: max pooled connections, and seconds to wait for a free one.
# STUDIO_PG_POOL_SIZE=10
# STUDIO_PG_POOL_TIMEOUT=30
# SQLite: persist app state on a mounted volume.
# Without this the container filesystem is wiped on every deploy.
STUDIO_DB_PATH=
# 1 (default) applies pending schema migrations at boot; 0 = refuse to boot with
# pending migrations — run `python -m app.migrate up` as a release step first.
# STUDIO_AUTO_MIGRATE=1

# ── Data gate & results (gateway.py / limits.py) ────────────────────────
# Wall-clock timeout for a single warehouse query executed through the gateway,
# in seconds. 0 (default) disables it. On expiry the request gets a clear
# QueryTimeout error; the connector call itself keeps running on its worker
# thread until the driver returns.
STUDIO_QUERY_TIMEOUT_S=0
# Server ceiling on rows in any result (read by app/limits.py).
# STUDIO_MAX_ROWS=50000
# Row cap per dashboard tile; effective cap is min(this, STUDIO_MAX_ROWS).
# STUDIO_DASH_TILE_ROWS=5000
# Chat messages store result rows. 0 (default) keeps them forever; N > 0 strips
# rows from assistant messages older than N days at startup (text, SQL, chart
# and columns stay; content.rows_purged=true marks them for the UI).
# STUDIO_MESSAGE_ROWS_RETENTION_DAYS=0

# ── Governance & semantic layer propagation ─────────────────────────────
# The active governance document and semantic model are process-local caches.
# Every accessor that gates a decision re-checks the newest applied document's
# (id, applied_at) in the store at most once per this many seconds, and reloads
# when it changed — so a policy applied on ANY replica is enforced fleet-wide
# within one interval instead of only by the process that served the PUT.
# The window is bounded, not zero. 0 = check on every decision; raise it when
# the state store is remote. Cost: one single-row indexed read per process per
# interval, whether or not anything changed.
# STUDIO_GOVERNANCE_REFRESH_S=5
# STUDIO_SEMANTIC_REFRESH_S=5

# ── Background jobs & schedulers (jobs.py) ──────────────────────────────
# Where the durable job queue runs: thread (in-process worker, default) |
# external (web enqueues only; run `python -m app.worker` as a second service) |
# off (nothing runs — tests).
STUDIO_WORKER_MODE=thread
# Handler threads per worker, queue poll interval (s), and seconds without a
# heartbeat before a running job is reclaimed by another worker.
STUDIO_JOB_WORKERS=4
STUDIO_JOB_POLL_S=1.0
STUDIO_JOB_STALE_S=300
# Seconds a chat task may sit 'running' with no live job before the reclaim
# pass fails it. Default: max(3 * STUDIO_JOB_STALE_S, 900). A task row and its
# job are written in ONE transaction, so no new orphan can be created — this
# only heals rows an older build stranded. Generous on purpose: the cost of
# waiting is a spinner, the cost of being early is failing a turn that was
# about to answer.
# STUDIO_CHAT_TASK_ORPHAN_S=900
# Periodic tickers, run by the worker under a DB lease (one instance per
# cluster). The lease TTL is max(4 * interval, 120s): a live tick renews every
# 10s, so it only expires after twelve consecutive failed renewals. A worker
# shutting down waits 5s for an in-flight tick and releases the leases of the
# ticks that FINISHED; a tick still running keeps its lease (logged) and it is
# left to expire — handing the name to another replica mid-pass would start a
# second copy of the same pass alongside a thread nothing can kill.
# Kill-switches (default on) and cadence in seconds.
# STUDIO_AUTOPILOT_TICKER=1
# STUDIO_AUTOPILOT_TICK_SECONDS=60
# STUDIO_GRAPH_SYNC_TICKER=1
# STUDIO_GRAPH_TICK_SECONDS=60

# ── Agent (LangChain / LangGraph — any model) ───────────────────────────
# Provider:model string passed to LangChain's init_chat_model.
# Examples:  anthropic:claude-opus-4-8   openai:gpt-4o   anthropic:claude-sonnet-5
STUDIO_LLM=anthropic:claude-opus-4-8
# Set the key for whichever provider you use. Without a key the app still
# works in a deterministic fallback mode (SELECT * ... LIMIT + auto chart).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Snowflake (optional) ────────────────────────────────────────────────
# DATABASE + SCHEMA also define the namespace the query guard accepts for this
# source. ARITY matters: Snowflake reads `x.sales` as SCHEMA.object and
# `a.b.sales` as DATABASE.SCHEMA.object, so the declared set is
# {schema, database.schema} — the DATABASE alone is NOT a one-part qualifier.
# A login usually sees more than one database; a reference into any other is
# rejected as "outside the configured namespace for this source".
# CASE: these are read as unquoted IDENTIFIERS, which Snowflake folds UP — so
# SNOWFLAKE_SCHEMA=public names the schema PUBLIC (list_tables() already reads
# it that way). Write the spelling the catalog reports.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC

# ── Databricks (optional) ───────────────────────────────────────────────
# CATALOG + SCHEMA also define the namespace the query guard accepts. ARITY
# matters: Unity Catalog / Spark read `x.sales` as SCHEMA.table in the current
# catalog and `a.b.sales` as CATALOG.SCHEMA.table, so the declared set is
# {schema, catalog.schema} — the CATALOG alone is NOT a one-part qualifier.
# Unity Catalog lets one warehouse token see far more than the catalog the
# sources were built from. Case-insensitive: Spark folds identifiers down even
# when they are quoted.
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=default
# The SQL warehouse that runs a submitted Jobs run's sql_tasks. REQUIRED for
# the Spark / Jobs deployment flow (flow.py -> databricks_conn.build_submission
# builds a Jobs 2.1 run-submit body: one sql_task per verified step, each
# carrying this warehouse_id). Unset, a spark_job deployment is REFUSED before
# the supervisor is called, with a reason naming this variable, rather than
# posting a body the API would reject. Reading through the Databricks source
# does not need it.
DATABRICKS_WAREHOUSE_ID=

# ── Neo4j / Cypher graph source (optional; see connectors/graph_conn.py) ─
# The HTTP transaction endpoint, e.g. https://host:7473. Dormant until set.
# Reads go through the same gateway as SQL, validated by app/cypherguard.py:
# one read-only statement (MATCH / OPTIONAL MATCH / WITH / UNWIND / RETURN /
# CALL), node labels are this source's "tables" and must be in the role's
# allowlist, unlabelled node patterns and every mutating or administrative
# clause are refused, and a LIMIT is appended when the final RETURN has none.
# Scope follows Cypher's own rules: WITH replaces the scope with what it
# projects, UNION starts a new query part with an empty one, and a CALL {}
# subquery sees only what its importing WITH hands it — out of scope a bare
# (n) is a FRESH binding over the whole graph and is refused like any other
# unlabelled node. Every label a pattern can match must be NAMED: :A|B, :A&B
# and :(A|B) are checked name by name, :!A and :% match by exclusion and are
# refused, and a dynamic :$(...) label or relationship type is refused unless
# it is a static string literal (anything else cannot be checked before the
# query runs). A pattern comprehension in a projection is checked as the
# traversal it is. This source declares NO qualifiers — labels have no
# namespace — which is not the same as "no checking".
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ── Azure / Entra SSO + Microsoft 365 extraction (optional; see auth.py) ─
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# SSO redirect — register this exact URI (note the /api prefix) in the app registration.
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/azure/callback
# Microsoft 365 connector (delegated OAuth) return URI; defaults to
# $STUDIO_PUBLIC_URL/api/m365/oauth/callback, else the localhost value below.
STUDIO_GRAPH_REDIRECT_URI=http://localhost:8000/api/m365/oauth/callback
# Public origin of this deployment. Combined with /api/m365/webhook to register
# Graph change-notification webhooks; webhooks are skipped when unset.
STUDIO_PUBLIC_URL=

# ── MCP servers (optional) ──────────────────────────────────────────────
# JSON map of MCP servers the agent can use as extra tools, e.g.:
# STUDIO_MCP_SERVERS={"internal": {"transport": "streamable_http", "url": "https://mcp.company.com/mcp"}, "fs": {"transport": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-everything"]}}
STUDIO_MCP_SERVERS=

# ── Tool-builder sandbox (approved model-generated MCP servers) ──────────
# How approved built tools run: "process" (default; rlimits + watchdog + minimal
# env, shares the host uid/FS/network) or "docker" (full isolation via
# scripts/Dockerfile.toolrunner). "process" is fine for local development —
# but PRODUCTION REFUSES TO BOOT on it: a built tool is model-written code, and
# under this runner it runs as the app's own uid with the app's .env, database
# and network. Copying this file to production means setting
# STUDIO_TOOL_RUNNER=docker (or one of the two variables below).
STUDIO_TOOL_RUNNER=process
# The explicit production opt-in: 1/true/yes = "I accept that approved
# generated code runs with the app's own filesystem, network and credentials".
# The only way to keep the process runner in production; boots with a WARNING.
# STUDIO_TOOL_RUNNER_ALLOW_PROCESS=
# The tool builder itself: ON unless set to a non-truthy value. 0 disables
# built tools entirely (owner-scoped MCP registrations are refused and stored
# ones stop loading), which also satisfies the production runner gate above.
# STUDIO_TOOLBUILDER=1
# Comma-separated env var NAMES copied into a built tool's environment. This is
# the ONLY way a credential reaches a tool; everything else is withheld. Default: none.
STUDIO_TOOL_ENV_ALLOW=
# Wall-clock cap per tool process (seconds; exit 124 when exceeded).
STUDIO_TOOL_MAX_SECONDS=900
# CPU-seconds and address-space limits (RLIMIT_CPU / RLIMIT_AS; the memory cap
# is also the docker --memory value). RLIMIT_AS is skipped on macOS.
STUDIO_TOOL_CPU_SECONDS=120
STUDIO_TOOL_MEMORY_MB=512
# docker runner only: --network value ("none" = no network), --cpus, and the image.
STUDIO_TOOL_NETWORK=none
STUDIO_TOOL_CPUS=1
STUDIO_TOOL_IMAGE=studio-toolrunner:latest
# The sandbox dir approved servers are written to and confined in
# (default: backend/toolbuilder_sandbox).
# STUDIO_TOOLBUILDER_DIR=

# ── Marketing stack connectors (optional; each appears as a source) ─────
# Simple API-key tools (live):
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_INDEX=
BRAZE_API_KEY=
BRAZE_REST_ENDPOINT=https://rest.iad-01.braze.com
QUALTRICS_API_TOKEN=
QUALTRICS_DATACENTER=iad1
DYNAMIC_YIELD_API_KEY=
# OAuth-app tools (see connectors/marketing.py for the per-tool setup):
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_ADS_CUSTOMER_ID=
MSADS_DEVELOPER_TOKEN=
SPRINKLR_ACCESS_TOKEN=
POWERBI_CLIENT_ID=

# Entra group -> Studio role mapping for SSO (JSON; highest role wins)
AZURE_GROUP_ROLE_MAP={"Studio-Admins": "admin", "Marketing-Analysts": "analyst"}
# Where the Entra callback sends the browser back to. It carries a single-use,
# 60-second ?sso_code= (never the token), which the SPA trades at
# POST /api/auth/sso/exchange. That map lives in the process that handled the
# callback, so behind several replicas enable sticky sessions.
FRONTEND_URL=http://localhost:5173

# ── Pipeline Control Service (optional; see platforms.py) ───────────────
# Each platform is available once its creds are set; unconfigured platforms
# are listed but cannot be triggered.
# Airflow — AIRFLOW_TOKEN (Bearer) OR AIRFLOW_USERNAME + AIRFLOW_PASSWORD
# (Basic on v1, JWT exchange on v2). API version: "v1" (default) or "v2".
AIRFLOW_URL=
AIRFLOW_TOKEN=
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
AIRFLOW_API_VERSION=v1
# Databricks Jobs — reuses DATABRICKS_SERVER_HOSTNAME + DATABRICKS_TOKEN from
# the Databricks section above. The staged flow's spark_job deployment also
# needs DATABRICKS_WAREHOUSE_ID from that section (it is the compute inside
# every sql_task of the submitted run).
# dbt Cloud — job_id can also come per-run from the payload:
DBT_CLOUD_ACCOUNT_ID=
DBT_CLOUD_API_TOKEN=
DBT_CLOUD_JOB_ID=
DBT_CLOUD_BASE_URL=https://cloud.getdbt.com
# Kubernetes Spark operator (SparkApplication CRD) — service-account token;
# set K8S_VERIFY_SSL=false for self-signed API servers:
K8S_API_URL=
K8S_TOKEN=
K8S_NAMESPACE=default
K8S_VERIFY_SSL=true

# ── Object storage as SQL (DuckDB views; see connectors/objectstore.py) ──
# Admins register datasets (Governance → Object storage) or bootstrap here:
# STUDIO_OBJECT_DATASETS={"s3":[{"name":"orders","uri":"s3://bucket/orders/*.parquet","format":"parquet"}]}
STUDIO_OBJECT_DATASETS=
STUDIO_DUCKDB_MEMORY=2GB
# S3 (also MinIO/R2 via the endpoint override):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SESSION_TOKEN=
STUDIO_S3_ENDPOINT=
STUDIO_S3_URL_STYLE=path
STUDIO_S3_USE_SSL=true
# GCS — HMAC interoperability keys (NOT a service-account JSON):
GCS_HMAC_KEY_ID=
GCS_HMAC_SECRET=
# Azure Blob — connection string, or a service principal (distinct from the
# AZURE_* SSO vars above):
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_TENANT_ID=
AZURE_STORAGE_CLIENT_ID=
AZURE_STORAGE_CLIENT_SECRET=

# ── BigQuery (read-only; see connectors/bigquery_conn.py) ────────────────
# Inline service-account JSON (raw or base64 — a PaaS can only set env vars),
# or GOOGLE_APPLICATION_CREDENTIALS above, or ADC (then set BIGQUERY_PROJECT).
BIGQUERY_CREDENTIALS_JSON=
# PROJECT + DATASET also define the namespace the query guard accepts
# ({dataset, project.dataset} — one part is a DATASET in the default project,
# two parts are PROJECT.DATASET); write table names bare or dataset-qualified.
# CASE-SENSITIVE: BigQuery dataset and table ids are not folded, so the
# configured spelling is the one the guard accepts.
BIGQUERY_PROJECT=
BIGQUERY_DATASET=
BIGQUERY_MAX_BYTES_BILLED=1000000000

# PostgreSQL data source (a second SQL warehouse). Dormant until set.
# POSTGRES_SCHEMA (default public), with the database named in the DSN, is also
# the namespace the query guard accepts ({schema, dbname.schema}, at those
# arities) — a login that can also see secret_schema still cannot be asked to
# read it. And because a BARE name carries no namespace to check, every
# connection is opened with options=-c search_path="<POSTGRES_SCHEMA>" (a
# keyword argument, so it beats anything in the DSN; double-quoted so the
# server does not fold it): an unqualified allowed name can only ever mean this
# schema, never whichever one came first on the server's default search_path.
# The value is therefore the EXACT stored schema name — the same spelling
# list_tables() matches information_schema against — and must be a plain
# identifier ([A-Za-z0-9_$]+); anything else fails the connection closed rather
# than being pasted into libpq's option string.
# POSTGRES_DSN=postgresql://user:pass@localhost:5432/warehouse
# POSTGRES_SCHEMA=public
