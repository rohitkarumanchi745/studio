# Build deploy/airflow/Dockerfile once, then run it as four services/jobs with
# AIRFLOW_ROLE=init, api-server, scheduler, and dag-processor respectively.
# init must run to completion first. All except api-server may stay private.

AIRFLOW_ROLE=init
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg://airflow:REPLACE_ME@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=REPLACE_WITH_A_FERNET_KEY
AIRFLOW__API__SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AIRFLOW__API_AUTH__JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-api:8080/execution/
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags

# Mount one ReadWriteMany filesystem at /opt/airflow/dags RW on the Studio
# external worker and init, and RO on the scheduler and DAG processor. The web
# process does not need it. A missing shared init sentinel stops the latter two
# roles instead of silently accepting an isolated per-container directory.

# The image uses FAB auth. Set these only on the one-shot init role to let the
# upstream Airflow entrypoint create Studio's API account after migration.
_AIRFLOW_DB_MIGRATE=true
_AIRFLOW_WWW_USER_CREATE=true
_AIRFLOW_WWW_USER_USERNAME=studio
_AIRFLOW_WWW_USER_PASSWORD=REPLACE_ME
_AIRFLOW_WWW_USER_EMAIL=studio@example.invalid
_AIRFLOW_WWW_USER_ROLE=User

# Define the connection ID referenced by STUDIO_AIRFLOW_CONNECTIONS_JSON.
AIRFLOW_CONN_STUDIO_POSTGRES=postgresql://warehouse_user:REPLACE_ME@warehouse:5432/warehouse

# Studio service variables (not Airflow component variables):
# AIRFLOW_URL=https://airflow.example.com
# AIRFLOW_API_VERSION=v2
# AIRFLOW_USERNAME=studio
# AIRFLOW_PASSWORD=<same init secret>
# STUDIO_AIRFLOW_DAGS_DIR=/opt/airflow/dags
# STUDIO_AIRFLOW_CONNECTIONS_JSON={"postgres":"studio_postgres"}
